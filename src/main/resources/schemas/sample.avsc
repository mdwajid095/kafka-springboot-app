  "fields": [
    { "name": "name", "type": "string" },
    { "name": "empid", "type": "string" },
    {
      "name": "address",
      "type": {
        "type": "record",
        "name": "Address",
        "fields": [
          { "name": "number", "type": "int" },
          { "name": "city", "type": "string" },
          { "name": "country", "type": "string" }
        ]
      }
    },
    { "name": "salary", "type": "double" }
  ]
}
